meta {
  name: [mutates] DELETE /messaging/conversations/{id}/participants/{userId}
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/messaging/conversations/{{id}}/participants/{{userId}}
  body: none
  auth: bearer
}

