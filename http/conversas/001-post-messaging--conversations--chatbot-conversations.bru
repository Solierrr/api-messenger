meta {
  name: [mutates] POST /messaging/conversations/chatbot-conversations
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/messaging/conversations/chatbot-conversations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "userType": "REQUESTER"
  }
}

docs {
  Inicia uma conversa com o chatbot
  o inciador da conversa é o id do JWT do usuario autenticado
  This operation may change server state.
}
