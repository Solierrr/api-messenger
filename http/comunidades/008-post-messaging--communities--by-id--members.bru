meta {
  name: [mutates] POST /messaging/communities/{id}/members
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/messaging/communities/{{id}}/members
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "userIds": [
      "{{sampleUuid}}"
    ],
    "role": "OWNER"
  }
}

docs {
  Adiciona/altera papel de membros
  Recusado (422): membros e papéis seguem o projeto e são geridos pela página do projeto
  This operation may change server state.
}
