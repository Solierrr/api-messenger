meta {
  name: [mutates] POST /messaging/communities
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/messaging/communities
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "projectId": "{{sampleUuid}}"
  }
}

docs {
  Cria a comunidade de um projeto
  Quem cria vira OWNER | memberIds opcionais entram como MEMBER | Uma comunidade por projeto
  This operation may change server state.
}
