meta {
  name: [mutates] POST /messaging/communities
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/messaging/communities
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "projectId": "{{sampleUuid}}"
  }
}

docs {
  Cria a comunidade de um projeto
  Membros e papéis vêm do projeto na api-core | memberIds não concede participação | Uma comunidade por projeto; se já existir, é sincronizada e devolvida
  This operation may change server state.
}
