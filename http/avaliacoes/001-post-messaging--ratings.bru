meta {
  name: [mutates] POST /messaging/ratings
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/messaging/ratings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "evaluatedId": "{{sampleUuid}}",
    "typeRate": "PROFISSIONAL",
    "rating": 1
  }
}

docs {
  Cria uma nova avaliação
  O avaliador (evaluatorId) é sempre o usuário autenticado da requisição. Status inicial é sempre ACTIVE.
  This operation may change server state.
}
