# Variáveis de ambiente do serviço
MONGO_URI=mongodb://localhost:27017/solaria_messenger_db

# URI do JWKS de api-auth (validação do JWT de usuário RS256)
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json

# OpenTelemetry Collector 
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# identidade do servico no backend de observabilidade
SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=local

# head sampling (100%) | tail sampling decidido pelo collector
OTEL_TRACES_SAMPLING_PROBABILITY=1.0