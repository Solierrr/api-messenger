# Fonte de verdade real é o Infisical — este arquivo só documenta quais
# variáveis existem. Ver design em docs-warehouse/architecture.

# /database
DB_MONGO_URI=mongodb://localhost:27017
DB_MONGO_MESSENGER=solaria_messenger_db

# /auth
SERVICE_JWT_SECRET=
SERVICE_CLIENT_SECRET=

# /service-urls
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
AUTH_SERVICE_URL=http://localhost:8081
PERSISTENCE_BASE_URL=http://localhost:8080

# /otel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=local
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
